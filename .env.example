# Copy to .env on the server (chmod 600). NEVER commit .env. Values below are placeholders, not secrets.
NODE_ENV=production
API_DOMAIN=api.example.com                  # domain of the API (DNS A record -> server IP); Caddy gets the certificate itself
SITE_URL=https://api.example.com            # public address of the API: it appears in the download links in emails
IP_SALT=                                    # random string, 32+ chars (openssl rand -hex 32)
TRUST_PROXY=true                            # behind Caddy

# Browser origins allowed to call the API (exact https origins, comma-separated): the Tilda site
ALLOWED_ORIGINS=https://www.example.com
# Where Stripe returns the buyer. {locale} = ru|fr|en
CHECKOUT_SUCCESS_URL=https://www.example.com/{locale}/merci
CHECKOUT_CANCEL_URL=https://www.example.com/{locale}/shop

# Notifications. Production does not start with 'file' (messages would never reach a person).
OWNER_EMAIL=owner@example.com
OWNER_CHANNEL=smtp                          # smtp | telegram
CLIENT_CHANNEL=smtp                         # buyers get their links by email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=starttls                        # tls (465) | starttls (587)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=orders@example.com                # an address the SMTP service lets you send from (verify the domain: SPF/DKIM)
MAIL_FROM_NAME=AINA Évidence
MAIL_REPLY_TO=owner@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payments. OFF until the owner approves going live. Primary provider: Revolut (docs/REVOLUT.md).
PAYMENT_PROVIDER=revolut                    # revolut (primary) | stripe (disabled fallback module, no registration needed)
PAYMENTS_ENABLED=false
REVOLUT_ENV=sandbox                         # sandbox | production (production also needs LIVE_PAYMENTS_APPROVED)
REVOLUT_API_KEY=                            # Merchant API secret key: sandbox first. Server environment only.
REVOLUT_WEBHOOK_SECRET=                     # wsk_... signing secret of the webhook /api/webhooks/revolut
REVOLUT_API_VERSION=2024-05-01
LIVE_PAYMENTS_APPROVED=                     # set to owner-approved ONLY after the owner's explicit decision (production)
ENABLED_CURRENCIES=EUR                      # RUB additionally needs RUB_PAYMENTS_APPROVED=owner-approved (lawful working channel)
RUB_PAYMENTS_APPROVED=
# Stripe fallback (used only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Encrypted backups (daily, by the backup container)
BACKUP_PASSPHRASE=                          # 20+ chars; store a copy in your password manager: without it backups cannot be read
BACKUP_PING_URL=                            # optional dead-man switch, e.g. a free healthchecks.io check URL
S3_ENDPOINT=                                # off-site storage, S3-compatible (Backblaze B2, Cloudflare R2), https only
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=                           # a key limited to this bucket
S3_SECRET_ACCESS_KEY=
S3_PREFIX=backups/
