# Copy to .env (never commit .env). All values are optional; payments and external channels are OFF by default.
PORT=8080
SITE_URL=https://example.invalid            # real public origin, set before launch
TRUST_PROXY=false                           # true only behind your reverse proxy
IP_SALT=change-me-to-random-string
OWNER_EMAIL=globalainanutrition@gmail.com
OWNER_CHANNEL=file                          # file | telegram
CLIENT_CHANNEL=file                         # file (no email provider connected yet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAYMENTS_ENABLED=false                      # set true ONLY after the owner approves going live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WORKER=on
# Checkout currencies. RUB prices exist in the catalog, but RUB payments stay OFF until legal + provider confirmation.
ENABLED_CURRENCIES=EUR
# Browser origins allowed to call the API (the Tilda site), comma-separated, exact match. Example: https://aina-evidence.tilda.ws
ALLOWED_ORIGINS=
# Where Stripe returns the buyer ({locale} = ru|fr|en). Example: https://your-tilda-domain/{locale}/merci
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
